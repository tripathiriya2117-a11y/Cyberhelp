# CyberHelp Configuration
# Generate a secure random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5000
FLASK_DEBUG=0
FLASK_ENV=development

# Optional Google Gemini API Key for AI Chatbot Assistant
# Obtain a free key from https://aistudio.google.com/app/apikey
# If left blank, CyberHelp uses its intelligent built-in offline safety knowledge engine.
GEMINI_API_KEY=

# Admin credentials - MUST be set for initial setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
